    "intake": "node --disable-warning=ExperimentalWarning src/cli.ts intake",
    "wayfinder": "node --disable-warning=ExperimentalWarning src/cli.ts wayfinder",
    "discover": "node --disable-warning=ExperimentalWarning src/cli.ts discover",
    "radar": "node --disable-warning=ExperimentalWarning src/radar/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0"
