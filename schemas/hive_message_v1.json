{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hive bounded job or event v1",
  "oneOf": [
    {
      "$ref": "#/$defs/job"
    },
    {
      "$ref": "#/$defs/event"
    }
  ],
  "$defs": {
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "question",
        "created_at",
        "action",
        "budget"
      ],
      "properties": {
        "version": {
          "const": "1"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_events",
            "max_attempts",
            "max_seconds",
            "max_cost_usd"
          ],
          "properties": {
            "max_events": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "max_attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "max_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            },
            "max_cost_usd": {
              "const": 0
            }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "job_id",
        "type",
        "payload"
      ],
      "properties": {
        "version": {
          "const": "1"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "job_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "type": {
          "enum": [
            "evidence",
            "transient_error",
            "permanent_error",
            "refusal",
            "cancel",
            "review",
            "outside_eye"
          ]
        },
        "payload": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "evidence"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sources",
                  "claim",
                  "source_ids",
                  "kind"
                ],
                "properties": {
                  "sources": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 5,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "url",
                        "accessed_at",
                        "content",
                        "sha256"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "url": {
                          "type": "string",
                          "format": "uri",
                          "pattern": "^https://"
                        },
                        "accessed_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "content": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 20000
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      }
                    }
                  },
                  "claim": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "source_ids": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    }
                  },
                  "kind": {
                    "enum": [
                      "reported_fact",
                      "inference"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "transient_error"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "retry_after_seconds"
                ],
                "properties": {
                  "code": {
                    "enum": [
                      "TIMEOUT",
                      "RATE_LIMIT",
                      "SERVER_ERROR"
                    ]
                  },
                  "retry_after_seconds": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 300
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "review",
                  "outside_eye"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "verdict",
                  "notes"
                ],
                "properties": {
                  "verdict": {
                    "enum": [
                      "pass",
                      "veto",
                      "unknown"
                    ]
                  },
                  "notes": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "cancel",
                  "permanent_error",
                  "refusal"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {}
              }
            }
          }
        }
      ]
    }
  }
}
