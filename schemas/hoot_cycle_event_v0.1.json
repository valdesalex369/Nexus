{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/hoot_cycle_event_v0.1.json",
  "title": "Hoot Cycle Event v0.1",
  "description": "Append-only machine-readable record for one Hoot training/operations cycle. Unknown telemetry is null, never fabricated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "cycle_id", "timestamp", "agent", "objective",
    "selected_task", "selection_reason", "success_criteria", "actions",
    "evidence", "result", "failure_mode", "lesson", "next_priority",
    "estimated_value", "human_action_required", "metrics"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "cycle_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "agent": {"const": "Hoot"},
    "objective": {"type": "string", "minLength": 1},
    "selected_task": {"type": "string", "minLength": 1},
    "selection_reason": {"type": "string", "minLength": 1},
    "success_criteria": {
      "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}
    },
    "actions": {
      "type": "array", "items": {"type": "string", "minLength": 1}
    },
    "tools_used": {
      "type": "array", "items": {"type": "string", "minLength": 1}, "default": []
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source", "observation"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "observation": {"type": "string", "minLength": 1},
          "digest_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "result": {"enum": ["PASS", "PARTIAL", "BLOCKED", "FAIL"]},
    "failure_mode": {"type": ["string", "null"]},
    "lesson": {"type": "string", "minLength": 1},
    "next_priority": {"type": "string", "minLength": 1},
    "estimated_value": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "human_action_required": {"type": ["string", "null"]},
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_calls", "failed_tool_calls", "estimated_compute_units", "estimated_cost_usd", "human_interventions"],
      "properties": {
        "tool_calls": {"type": ["integer", "null"], "minimum": 0},
        "failed_tool_calls": {"type": ["integer", "null"], "minimum": 0},
        "estimated_compute_units": {"type": ["number", "null"], "minimum": 0},
        "estimated_cost_usd": {"type": ["number", "null"], "minimum": 0},
        "human_interventions": {"type": "integer", "minimum": 0}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "PASS"}}},
      "then": {"properties": {"evidence": {"minItems": 1}, "failure_mode": {"type": "null"}}}
    },
    {
      "if": {"properties": {"result": {"enum": ["PARTIAL", "BLOCKED", "FAIL"]}}},
      "then": {"properties": {"failure_mode": {"type": "string", "minLength": 1}}}
    }
  ]
}
