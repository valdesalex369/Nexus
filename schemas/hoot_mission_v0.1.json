{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexus://schemas/hoot_mission_v0.1.json",
  "title": "Hoot Mission v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission_id",
    "agent",
    "objective",
    "selected_task",
    "success_criteria",
    "requested_capabilities",
    "authority_class",
    "limits"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "mission_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._:-]+$"},
    "agent": {"const": "Hoot"},
    "objective": {"type": "string", "minLength": 1},
    "selected_task": {"type": "string", "minLength": 1},
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "requested_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "inspect_internal_state",
          "read_internal_artifact",
          "write_sandbox_artifact",
          "hash_artifact",
          "append_internal_ledger",
          "evaluate_internal_cycle",
          "query_internal_reliability"
        ]
      }
    },
    "authority_class": {
      "enum": ["REVERSIBLE_INTERNAL"]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_steps", "max_tool_calls", "max_recursion_depth"],
      "properties": {
        "max_steps": {"type": "integer", "minimum": 1, "maximum": 50},
        "max_tool_calls": {"type": "integer", "minimum": 1, "maximum": 50},
        "max_recursion_depth": {"type": "integer", "minimum": 0, "maximum": 3},
        "estimated_cost_usd": {"type": ["number", "null"], "minimum": 0},
        "estimated_compute_units": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
