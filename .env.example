# NEXUS environment. Copy to .env and fill in what you actually have.
# Nothing here is required to boot. Providers light up only when their key is present;
# `npm run doctor` reports exactly which are live and which are dark.

# --- Model providers (the Task Router picks among whichever are live) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=          # KIMI — long-horizon research / document intelligence
MOONSHOT_MODEL=kimi-k3     # Kimi API default. Kimi Code keys can use k3 with the coding base URL.
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# Optional base-URL overrides (self-host, proxy, or gateway)
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=
MOONSHOT_BASE_URL=

# --- Intelligence data providers ---
WORLD_MONITOR_API_KEY=     # WorldMonitor REST/MCP baseline; never commit a live key.

# --- Governance ---
NEXUS_CAPITAL_LEVEL=0      # 0=read-only .. 5=constrained autonomous allocation. See src/policy.
NEXUS_MAX_RUN_USD=1.00     # hard per-run spend ceiling enforced by the Gauntlet
NEXUS_DB=./data/nexus.db
