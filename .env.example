# NEXUS environment. Copy to .env and fill in only what you actually have.
# Never put a wallet seed phrase, recovery phrase, private key, signing key,
# browser session, or broker password/token in this file.

# --- Local operator mode (focus only; it never expands authority) ---
NEXUS_OPERATING_MODE=NORMAL  # NORMAL | SUPERNOVA | GOTHAM; read once at process start
NEXUS_CAPITAL_LEVEL=0        # the Operations MCP refuses to start at any other level
NEXUS_MAX_RUN_USD=1.00       # hard per-run model-spend ceiling enforced by the Gauntlet

# --- Local read-only Operations MCP ---
NEXUS_MCP_REPO_ROOT=.
NEXUS_MCP_RUNTIME_ROOT=./.nexus-runtime
NEXUS_MCP_MAX_SNAPSHOT_BYTES=5242880

# --- Public watch-only identifiers (optional) ---
# Public address only. These currently report configuration truth; wallet observation
# is NOT implemented and no signing, swap, transfer, or trade tool exists.
SOLANA_PUBLIC_ADDRESS=
EVM_PUBLIC_ADDRESS=

# --- Model providers (the Task Router picks among whichever are live) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=          # KIMI — long-horizon research / document intelligence
MOONSHOT_MODEL=kimi-k3     # Kimi API default. Kimi Code keys can use k3 with the coding base URL.
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# Optional base-URL overrides (self-host, proxy, or gateway)
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=
MOONSHOT_BASE_URL=

# --- Intelligence data providers ---
WORLD_MONITOR_API_KEY=     # WorldMonitor REST/MCP baseline; never commit a live key.

# --- Local storage ---
NEXUS_DB=./data/nexus.db
