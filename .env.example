# ===== NEXUS Environment Configuration =====

# --- Feature Flags ---
NEXUS_TEAMS_ENABLED=true
NEXUS_MAX_AGENTS_PER_TEAM=10
NEXUS_PARALLEL_EXECUTION=true

# --- Telegram Conductor ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Etherscan (On-Chain Tracking) ---
ETHERSCAN_API_KEY=

# --- Twitter/X API ---
TWITTER_BEARER_TOKEN=
TWITTER_USERNAME=Xelarocket

# --- CoinGecko (free tier works) ---
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# --- Fear & Greed ---
FEAR_GREED_URL=https://api.alternative.me/fng/

# --- Kalshi (Prediction Markets) ---
# IMPORTANT: Use demo first. Never go live without 50+ paper trades.
KALSHI_ENV=demo
KALSHI_API_KEY=
KALSHI_API_SECRET=
KALSHI_BASE_URL=https://demo-api.kalshi.co/trade-api/v2

# --- Wallet Tracking (public address only — NEVER store private keys) ---
WALLET_ADDRESS=

# --- Timing ---
HUB_CYCLE_MS=900000
ENGAGEMENT_MS=1800000
FEAR_GREED_MS=21600000
COMPETITOR_CRON=0 8 * * *
RECALIBRATION_CRON=0 2 * * *

# --- Limits ---
KELLY_MAX_PERCENT=5
MIN_EDGE_PERCENT=4
PAPER_TRADES_REQUIRED=50

# ===== HERMES Intelligence System =====

# --- WorldMonitor (primary world-event source — public API is free, no key) ---
# Key only needed for Pro tier (faster refresh). Pin WORLDMONITOR_EVENTS_PATH
# after verifying against the OpenAPI spec (github.com/koala73/worldmonitor).
WORLDMONITOR_API_BASE=https://api.worldmonitor.app
WORLDMONITOR_KEY=
WORLDMONITOR_EVENTS_PATH=

# --- GDELT DOC 2.0 (secondary source + tone timelines — free, no key) ---
GDELT_DOC_URL=https://api.gdeltproject.org/api/v2/doc/doc

# --- NewsAPI (tertiary fallback for geopolitical + industry scanning) ---
NEWSAPI_KEY=

# --- GitHub (DevIntel — optional, increases rate limit) ---
GITHUB_TOKEN=

# --- HERMES Timing ---
HERMES_CYCLE_MS=14400000
HERMES_CRON=0 */4 * * *

# --- Server ---
SERVER_PORT=3001
NEXUS_LOG_LEVEL=INFO
